{% extends 'base.html.twig' %}

{% block title %}{{ 'produit.liste'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'produit.liste'|trans }}</h1>

    {% if is_granted('ROLE_ADMIN') %}
        <p><a href="{{ path('app_produit_ajouter') }}">{{ 'produit.ajouter'|trans }}</a></p>
    {% endif %}

    <div class="produits">
        {% for produit in produits %}
            <div class="produit">
                {% if produit.photo %}
                    <img src="{{ asset('uploads/' ~ produit.photo) }}" alt="{{ produit.nom }}">
                {% endif %}
                <h3><a href="{{ path('app_produit_fiche', {'id': produit.id}) }}">{{ produit.nom }}</a></h3>
                <p class="prix">{{ produit.prix|number_format(2, ',', ' ') }} €</p>
            </div>
        {% else %}
            <p>{{ 'produit.aucun'|trans }}</p>
        {% endfor %}
    </div>
{% endblock %}
