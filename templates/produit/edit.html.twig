{% extends 'base.html.twig' %}

{% block title %}{{ 'produit.modifier_titre'|trans({'%nom%': produit.nom}) }}{% endblock %}

{% block body %}
    <h1>{{ 'produit.modifier_titre'|trans({'%nom%': produit.nom}) }}</h1>

    {{ include('produit/_form.html.twig', {'button_label': 'produit.modifier'|trans}) }}

    <div class="actions">
        <a href="{{ path('app_produit_fiche', {'id': produit.id}) }}">{{ 'produit.retour_produit'|trans }}</a>

        {{ include('produit/_delete_form.html.twig') }}
    </div>
{% endblock %}
