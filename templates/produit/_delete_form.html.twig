<form method="post" action="{{ path('app_produit_supprimer', {'id': produit.id}) }}" onsubmit="return confirm('{{ 'produit.confirmer_suppression'|trans|e('js') }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
    <button class="btn">{{ 'produit.supprimer'|trans }}</button>
</form>
