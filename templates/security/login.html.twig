{% extends 'base.html.twig' %}

{% block title %}{{ 'connexion.titre'|trans }}{% endblock %}

{% block body %}
    <form method="post">
        {% if error %}
            <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                {{ 'connexion.deja_connecte'|trans({'%email%': app.user.userIdentifier}) }}
                <a href="{{ logout_path() }}">{{ 'connexion.deconnexion'|trans }}</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">{{ 'connexion.titre'|trans }}</h1>
        <label for="username">{{ 'connexion.email'|trans }}</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
        <label for="password">{{ 'connexion.mot_de_passe'|trans }}</label>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-lg btn-primary" type="submit">
            {{ 'connexion.bouton'|trans }}
        </button>
    </form>
{% endblock %}
